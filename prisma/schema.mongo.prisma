generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MongoDB_URL")
}

model Example {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model Analytics {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  event String
  count Int
}
